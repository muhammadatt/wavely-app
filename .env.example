# Frontend env — copy to .env.local for dev; set the same names in Vercel.
# Everything is optional: with nothing set the app runs exactly as before.

# API server origin when it is on a different domain. Empty in dev (Vite
# proxies /api to localhost:3001).
# VITE_API_BASE_URL=https://api.example.com

# ─── Accounts (Supabase) — see docs/user-accounts.md ──────────────────────────
# Accounts are OFF unless both are set. Both are public by design.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OAuth providers enabled in the Supabase dashboard, comma-separated.
# VITE_AUTH_PROVIDERS=google

# ─── Ad pixels + consent — see src/platform/consent.js ────────────────────────
# Both OFF unless set. With neither set there is no consent bar and nothing
# loads. They load ONLY on the marketing pages (/effects/), ONLY after consent
# in the EEA / UK / Switzerland (and for unknown countries), and never in the
# editor. Bump CONSENT_VERSION in consent.js when you add a vendor.
# VITE_META_PIXEL_ID=123456789012345
# VITE_GOOGLE_ADS_ID=AW-123456789
# Linked from the consent bar's Details (hidden when unset).
# VITE_PRIVACY_URL=/privacy/
