# Frontend env — copy to .env.local for dev; set the same names in Vercel.
# Everything is optional: with nothing set the app runs exactly as before.

# API server origin when it is on a different domain. Empty in dev (Vite
# proxies /api to localhost:3001).
# VITE_API_BASE_URL=https://api.example.com

# ─── Accounts (Supabase) — see docs/user-accounts.md ──────────────────────────
# Accounts are OFF unless both are set. Both are public by design.
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# OAuth providers enabled in the Supabase dashboard, comma-separated.
# VITE_AUTH_PROVIDERS=google
